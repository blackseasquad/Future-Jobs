# Copy to .env.local and fill in (Project Settings -> API in Supabase)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Server-side only (Vercel → Settings → Environment Variables). Never prefix these with VITE_. ---
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # used only by /api/cron and /api/admin to write market data
# CRON_SECRET=                      # random, >= 16 chars; Vercel sends it to /api/cron/daily-refresh
# ADMIN_EMAILS=you@example.com      # who may press "Обнови сега"
# GEMINI_API_KEY=                   # already used by the chat; reused for optional AI explanations
